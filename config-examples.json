{
  "pingInterval": "*/30 * * * *",
  "timeout": 30000,
  "endpoints": [
    {
      "name": "Simple GET Request",
      "url": "https://my-app.onrender.com",
      "method": "GET"
    },
    {
      "name": "GET with Auth Header",
      "url": "https://my-app.onrender.com/api/data",
      "method": "GET",
      "headers": {
        "Authorization": "Bearer ${API_TOKEN}"
      }
    },
    {
      "name": "POST Login with Credentials",
      "url": "https://my-app.onrender.com/api/login",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "username": "${LOGIN_USERNAME}",
        "password": "${LOGIN_PASSWORD}"
      }
    },
    {
      "name": "POST with Mixed Sensitive and Non-Sensitive Data",
      "url": "https://my-app.onrender.com/api/authenticate",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "X-API-Key": "${API_KEY}"
      },
      "body": {
        "service": "pinger",
        "token": "${AUTH_TOKEN}",
        "timestamp": "auto"
      }
    }
  ]
}
